<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="empty">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 2 0 0 0</pose>
      <diffuse>1.0 0.97 0.92 1</diffuse>
      <specular>0.7 0.7 0.7 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- 10cm reference grid at the working plane, so scale is legible -->
    <model name="scale_reference">
      <static>true</static>
      <pose>0.06 0 0.44 0 0 0</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>0.10 0.10 0.001</size></box></geometry>
          <material>
            <ambient>0.15 0.18 0.22 1</ambient>
            <diffuse>0.2 0.24 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- camera framed on the instrument working volume -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui><title>3D View</title><property key="showTitleBar" type="bool">false</property></gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.03 0.02 0.03</background_color>
        <camera_pose>0.16 -0.16 0.60 0 0.45 2.30</camera_pose>
        <camera_clip><near>0.002</near><far>200</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui><property key="resizable" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera tracking">
        <gz-gui><property key="resizable" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"/>
    </gui>
      <light type="point" name="fill">
      <pose>0.02 -0.08 0.62 0 0 0</pose>
      <diffuse>0.45 0.40 0.38 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>1.5</range><linear>0.6</linear></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
  </world>
</sdf>
