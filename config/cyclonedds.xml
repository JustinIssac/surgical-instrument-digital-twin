<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <!-- 1920x1080 BGR frames are ~6MB; default buffers drop them -->
      <MaxMessageSize>65500B</MaxMessageSize>
      <FragmentSize>64000B</FragmentSize>
      <Interfaces><NetworkInterface name="lo" priority="default"/></Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
      <Watermarks><WhcHigh>16MB</WhcHigh></Watermarks>
    </Internal>
  </Domain>
</CycloneDDS>
